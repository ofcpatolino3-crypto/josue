rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles (read & write accessible for sync and team management)
    match /user_profiles/{userId} {
      allow read, write: if true;
    }

    // Batches and global contacts (managed by admins or assigned attendants)
    match /lead_batches/{batchId} {
      allow read, write: if true;
    }

    match /global_contacts/{contactId} {
      allow read, write: if true;
    }

    // User-specific data: contacts & message templates
    match /users/{userId} {
      allow read, write: if true;

      match /contacts/{contactId} {
        allow read, write: if true;
      }

      match /templates/{templateId} {
        allow read, write: if true;
      }
    }
  }
}
